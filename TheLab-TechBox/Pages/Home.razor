<script>
console.log('=== BULLETPROOF SLIDESHOW LOADING ===');

// Global slideshow state with singleton protection
window.slideshowState = {
    currentIndex: 0,
    slideInterval: null,
    images: [],
    isRunning: false,
    isInitializing: false // NEW: Prevents multiple simultaneous initializations
};

// Bulletproof slideshow function with singleton protection
function startBulletproofSlideshow() {
    console.log('=== SLIDESHOW START REQUESTED ===');
    
    // SINGLETON PROTECTION: Don't start if already initializing
    if (window.slideshowState.isInitializing) {
        console.log('⚠️ Already initializing, skipping...');
        return;
    }
    
    // SINGLETON PROTECTION: Don't start if already running
    if (window.slideshowState.isRunning) {
        console.log('⚠️ Already running, stopping first...');
        stopSlideshow();
    }
    
    // Lock initialization
    window.slideshowState.isInitializing = true;
    console.log('🔒 Locked initialization');
    
    // Stop any existing slideshow completely
    if (window.slideshowState.slideInterval) {
        clearInterval(window.slideshowState.slideInterval);
        window.slideshowState.slideInterval = null;
        console.log('🛑 Cleared old interval');
    }
    
    // Find images
    const images = document.querySelectorAll('.gallery-image');
    const fallback = document.getElementById('gallery-fallback');
    
    console.log('Found', images.length, 'gallery images');
    
    if (images.length === 0) {
        console.log('No images found!');
        if (fallback) {
            fallback.style.display = 'block';
            fallback.style.background = '#008250';
        }
        window.slideshowState.isInitializing = false; // Unlock
        return;
    }
    
    // Store images globally and reset state
    window.slideshowState.images = Array.from(images);
    window.slideshowState.currentIndex = 0;
    
    // Hide fallback
    if (fallback) {
        fallback.style.display = 'none';
    }
    
    // CRITICAL: Force all images to be hidden with immediate effect
    images.forEach((img, index) => {
        img.style.opacity = '0';
        img.style.transition = 'opacity 1s ease-in-out';
        // Force browser to apply the change immediately
        img.offsetHeight; // Trigger reflow
        console.log('🔄 Reset image', index + 1, 'opacity to 0');
    });
    
    // Wait a moment for opacity changes to apply
    setTimeout(() => {
        // Show first image
        if (window.slideshowState.images[0]) {
            window.slideshowState.images[0].style.opacity = '1';
            console.log('✅ Showing first image');
        }
        
        // Start the slideshow interval
        window.slideshowState.slideInterval = setInterval(function() {
            if (window.slideshowState.images.length === 0) return;
            
            // Hide current image
            const currentImg = window.slideshowState.images[window.slideshowState.currentIndex];
            if (currentImg) {
                currentImg.style.opacity = '0';
            }
            
            // Move to next image
            window.slideshowState.currentIndex = (window.slideshowState.currentIndex + 1) % window.slideshowState.images.length;
            
            // Show next image
            const nextImg = window.slideshowState.images[window.slideshowState.currentIndex];
            if (nextImg) {
                nextImg.style.opacity = '1';
                console.log('➡️ Advanced to image', window.slideshowState.currentIndex + 1);
            }
            
        }, 2000); // Change every 2 seconds
        
        window.slideshowState.isRunning = true;
        window.slideshowState.isInitializing = false; // Unlock
        console.log('✅ Bulletproof slideshow started successfully');
        
    }, 100); // Small delay to ensure opacity changes are applied
}

// Function to completely stop slideshow
function stopSlideshow() {
    console.log('🛑 Stopping slideshow');
    if (window.slideshowState.slideInterval) {
        clearInterval(window.slideshowState.slideInterval);
        window.slideshowState.slideInterval = null;
    }
    window.slideshowState.isRunning = false;
    window.slideshowState.isInitializing = false;
}

// Safe initialization with debouncing
let initTimeout = null;
function safeInitSlideshow() {
    // Clear any pending initialization
    if (initTimeout) {
        clearTimeout(initTimeout);
    }
    
    // Debounce: Only start after 200ms of no new requests
    initTimeout = setTimeout(() => {
        console.log('=== SAFE INIT SLIDESHOW ===');
        startBulletproofSlideshow();
    }, 200);
}

// Single initialization point
function initSlideshow() {
    console.log('=== INIT SLIDESHOW CALLED ===');
    safeInitSlideshow();
}

// Method 1: DOM Content Loaded
document.addEventListener('DOMContentLoaded', function() {
    console.log('=== DOM LOADED - REQUESTING SLIDESHOW ===');
    initSlideshow();
});

// Method 2: Window Load
window.addEventListener('load', function() {
    console.log('=== WINDOW LOADED - REQUESTING SLIDESHOW ===');
    initSlideshow();
});

// Method 3: Immediate if DOM ready
if (document.readyState === 'complete' || document.readyState === 'interactive') {
    console.log('=== DOM ALREADY READY - REQUESTING SLIDESHOW ===');
    initSlideshow();
}

// Method 4: Single fallback timer (reduced from multiple)
setTimeout(function() {
    console.log('=== FALLBACK TIMER - REQUESTING SLIDESHOW ===');
    initSlideshow();
}, 1000);

// Method 5: Page visibility change (with debouncing)
document.addEventListener('visibilitychange', function() {
    if (!document.hidden) {
        console.log('=== PAGE VISIBLE - REQUESTING SLIDESHOW ===');
        initSlideshow();
    }
});

// Method 6: Window focus (with debouncing)
window.addEventListener('focus', function() {
    console.log('=== WINDOW FOCUS - REQUESTING SLIDESHOW ===');
    initSlideshow();
});

// Method 7: Blazor navigation detection
let lastUrl = location.href;
new MutationObserver(() => {
    const currentUrl = location.href;
    if (currentUrl !== lastUrl) {
        lastUrl = currentUrl;
        if (currentUrl.includes('localhost:5242') && !currentUrl.includes('/about') && !currentUrl.includes('/services')) {
            console.log('=== BLAZOR NAVIGATION TO HOME - REQUESTING SLIDESHOW ===');
            setTimeout(initSlideshow, 500);
        }
    }
}).observe(document, { subtree: true, childList: true });

// Method 8: Hash change detection (for single page apps)
window.addEventListener('hashchange', function() {
    console.log('=== HASH CHANGE - REQUESTING SLIDESHOW ===');
    setTimeout(initSlideshow, 300);
});

// Method 9: PopState detection (browser back/forward)
window.addEventListener('popstate', function() {
    console.log('=== POP STATE - REQUESTING SLIDESHOW ===');
    setTimeout(initSlideshow, 400);
});

// Global functions for manual control
window.restartSlideshow = function() {
    console.log('=== MANUAL RESTART REQUESTED ===');
    stopSlideshow();
    setTimeout(initSlideshow, 100);
};

window.stopSlideshow = stopSlideshow;

console.log('=== BULLETPROOF SLIDESHOW SCRIPT LOADED ===');
</script>

@code {
    private bool _hasRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                Console.WriteLine("Blazor: First render - Starting slideshow");
                // Force slideshow initialization on first render
                await JSRuntime.InvokeVoidAsync("eval", "if(typeof window.restartSlideshow === 'function') { console.log('Blazor: Calling restartSlideshow'); window.restartSlideshow(); }");
                _hasRendered = true;
            }
            else if (_hasRendered)
            {
                Console.WriteLine("Blazor: Subsequent render - Restarting slideshow");
                // Also restart on subsequent renders (navigation back)
                await Task.Delay(100); // Small delay to ensure DOM is ready
                await JSRuntime.InvokeVoidAsync("eval", "if(typeof window.restartSlideshow === 'function') { console.log('Blazor: Re-calling restartSlideshow'); window.restartSlideshow(); }");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Blazor: Error in OnAfterRenderAsync: {ex.Message}");
            // Fallback: try direct JavaScript call
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "setTimeout(function() { if(typeof window.restartSlideshow === 'function') { window.restartSlideshow(); } }, 500);");
            }
            catch (Exception fallbackEx)
            {
                Console.WriteLine($"Blazor: Fallback also failed: {fallbackEx.Message}");
            }
        }
    }
    
    protected override void OnInitialized()
    {
        Console.WriteLine("Blazor: Home component initialized");
    }

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine("Blazor: Parameters set - ensuring slideshow restart");
        if (_hasRendered)
        {
            try
            {
                await Task.Delay(200);
                await JSRuntime.InvokeVoidAsync("eval", "if(typeof window.restartSlideshow === 'function') { window.restartSlideshow(); }");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Blazor: Error in OnParametersSetAsync: {ex.Message}");
            }
        }
    }
    
    public void Dispose()
    {
        Console.WriteLine("Blazor: Home component disposed");
        try
        {
            // Stop slideshow when component is disposed
            JSRuntime.InvokeVoidAsync("eval", "if(typeof window.stopSlideshow === 'function') { window.stopSlideshow(); }");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Blazor: Error disposing: {ex.Message}");
        }
    }
}
