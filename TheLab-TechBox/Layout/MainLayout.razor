@namespace TheLab_TechBox.Layout
@inherits LayoutComponentBase

<!-- Top Header with Two Images -->
<div class="top-header w-full border-b-2 border-gray-400" style="background-color: #008250; min-height: 90px;">
    <div class="flex w-full h-full">
        <!-- Left Image - 30% width, fill background (now Header2.avif) -->
        <div class="bg-blue-500 flex items-center justify-center border-r-4 border-white text-white font-bold"
             style="background-image: url('/Header2.avif'); background-size: cover; background-position: center; width: 30%; min-height: 88px;"> 
        </div>
        <!-- Right Image - 70% width, fill background (now Header.avif) -->
        <div class="bg-green-500 flex items-center justify-center text-white font-bold"
             style="background-image: url('/Header.avif'); background-size: cover; background-position: center; width: 70%; min-height: 88px;">
        </div>
    </div>
</div>

<!-- Navigation - Reduced Height -->
<nav class="bg-white shadow-lg sticky top-0 z-40">
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-center h-12">
            <!-- Desktop Navigation -->
            <div class="hidden md:flex space-x-8">
                <a href="/" class="nav-link text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Home</a>
                <a href="/services" class="nav-link text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Our Services</a>
                <a href="/about" class="nav-link text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Who We Are</a>
                <a href="/contact" class="nav-link text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Contact</a>
            </div>

            <!-- Mobile Navigation Toggle -->
            <div class="md:hidden absolute right-4">
                <button type="button" data-mobile-menu-toggle class="text-gray-500 hover:text-gray-600 focus:outline-none focus:text-gray-600" aria-label="Toggle menu">
                    <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div data-mobile-menu class="hidden md:hidden pb-4">
            <div class="flex flex-col space-y-2">
                <a href="/" class="nav-link block text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Home</a>
                <a href="/services" class="nav-link block text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Our Services</a>
                <a href="/about" class="nav-link block text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Who We Are</a>
                <a href="/contact" class="nav-link block text-gray-700 hover:text-blue-600 px-3 py-2 font-medium transition-colors">Contact</a>
            </div>
        </div>
    </div>
</nav>

<!-- Main Content -->
<main class="flex-1">
    @Body
</main>

<!-- Footer -->
<footer class="text-white py-8 mt-16" style="background-color: #024d30;">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Payment Methods -->
            <div>
                <button data-payment-modal class="text-blue-400 hover:text-blue-300 font-semibold transition-colors cursor-pointer">
                    Payment Methods
                </button>
            </div>

            <!-- Store Name -->
            <div class="text-center">
                <h3 class="text-xl font-bold mb-2">The Lab Techbox</h3>
                <p class="text-gray-400">©2022 by The Lab Techbox</p>
            </div>

            <!-- Contact Link -->
            <div class="text-right">
                <a href="/contact" class="text-blue-400 hover:text-blue-300 font-semibold transition-colors">
                    Επικοινωνία
                </a>
            </div>
        </div>
    </div>
</footer>
