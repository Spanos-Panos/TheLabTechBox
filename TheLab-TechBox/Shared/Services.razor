@namespace TheLab_TechBox.Shared

<!-- Services Section with Background Image -->
<section id="services" class="py-20 bg-cover bg-center bg-fixed relative"
         style="background-image: url('/Assets/images/services-bg.jpg');">
    
    <!-- Background Overlay -->
    <div class="absolute inset-0 bg-black/50"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-16">
            <h2 class="text-4xl lg:text-5xl font-bold text-white mb-8">Our Services</h2>
            <div class="max-w-4xl mx-auto bg-white/90 backdrop-blur-sm rounded-2xl p-8 shadow-2xl">
                <p class="text-lg text-gray-800 leading-relaxed">
                    Εργαζόμαστε υπεύθυνα για να μπορούμε να σας προσφέρουμε την καλύτερη λύση στο πρόβλημά σας, στις πιο ανταγωνιστικές τιμές της αγοράς. 
                    Η συνεχής ενημέρωσή μας, πάνω σε θέματα τεχνολογίας, μας επιτρέπει να δίνουμε τις καλύτερες προτάσεις, τόσο σε θέματα εγκαταστάσεων 
                    συστημάτων ασφαλείας όσο και σε θέματα επισκευών, αναβαθμίσεων και πωλήσεων ηλεκτρονικών ειδών.
                </p>
                <p class="text-lg text-gray-800 mt-4 font-semibold">
                    Ρίξτε μια ματιά στις υπηρεσίες μας, για να ενημερωθείτε.
                </p>
            </div>
        </div>

        <!-- Service Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-8 mb-16">
            <!-- Security Systems -->
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden transform hover:scale-105">
                <div class="h-48 bg-cover bg-center" style="background-image: url('/Assets/images/security.jpg');"></div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Συστήματα Ασφαλείας</h3>
                    <p class="text-gray-600 text-sm">Συναγερμοί, κάμερες παρακολούθησης, πυρανίχνευση</p>
                </div>
            </div>

            <!-- Electronics Repair -->
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden transform hover:scale-105">
                <div class="h-48 bg-cover bg-center" style="background-image: url('/Assets/images/electronics.jpg');"></div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Επισκευή Ηλεκτρονικών</h3>
                    <p class="text-gray-600 text-sm">Επισκευές όλων των ηλεκτρονικών συσκευών</p>
                </div>
            </div>

            <!-- Mobile Repair -->
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden transform hover:scale-105">
                <div class="h-48 bg-cover bg-center" style="background-image: url('/Assets/images/mobile.jpg');"></div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Επισκευή Κινητών</h3>
                    <p class="text-gray-600 text-sm">Αντικατάσταση οθονών, μπαταριών, επισκευές</p>
                </div>
            </div>

            <!-- Computer Services -->
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden transform hover:scale-105">
                <div class="h-48 bg-cover bg-center" style="background-image: url('/Assets/images/computer.jpg');"></div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Υπολογιστές</h3>
                    <p class="text-gray-600 text-sm">Επισκευές, αναβαθμίσεις, συμβουλές αγοράς</p>
                </div>
            </div>

            <!-- TV Services -->
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden transform hover:scale-105">
                <div class="h-48 bg-cover bg-center" style="background-image: url('/Assets/images/tv.jpg');"></div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Τηλεοράσεις</h3>
                    <p class="text-gray-600 text-sm">Τοποθέτηση, επισκευή, συντονισμός κεραιών</p>
                </div>
            </div>
        </div>

        <!-- View More Button -->
        <div class="text-center">
            <a href="#full-services" class="inline-block bg-white text-blue-600 hover:bg-blue-50 px-12 py-4 rounded-full font-bold text-lg transition-all duration-300 transform hover:scale-105 shadow-lg">
                View More
            </a>
        </div>
    </div>
</section>
