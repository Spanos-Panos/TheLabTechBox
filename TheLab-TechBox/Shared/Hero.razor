@namespace TheLab_TechBox.Shared

<!-- Hero Section -->
<section id="home" class="py-16 bg-gradient-to-br from-blue-50 to-blue-100 min-h-screen flex items-center">
    <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row items-center gap-12">
            <!-- Left Side - Logo -->
            <div class="lg:w-1/2 text-center lg:text-left">
                <div class="mb-8">
                    <img src="/Assets/images/logo.png" alt="The Lab Techbox Logo" class="w-48 h-48 mx-auto lg:mx-0 object-contain tech-glow" />
                </div>
                <h1 class="text-4xl lg:text-6xl font-bold text-gray-800 mb-6 animate-slide-in">
                    The Lab <span class="text-blue-600">Techbox</span>
                </h1>
                <p class="text-xl text-gray-600 mb-8 animate-fade-in">
                    Επαγγελματικές επισκευές ηλεκτρονικών & εγκατάσταση συστημάτων ασφαλείας
                </p>
                <div class="flex flex-col sm:flex-row gap-4 animate-bounce-in">
                    <a href="#services" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg">
                        Οι Υπηρεσίες μας
                    </a>
                    <a href="#contact" class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300">
                        Επικοινωνία
                    </a>
                </div>
            </div>

            <!-- Right Side - Photo Gallery Box -->
            <div class="lg:w-1/2">
                <div class="bg-white rounded-2xl shadow-2xl p-6 animate-bounce-in">
                    <h3 class="text-2xl font-bold text-gray-800 mb-4 text-center">Το Εργαστήριό μας</h3>
                    <div data-gallery></div>
                </div>
            </div>
        </div>
    </div>
</section>
